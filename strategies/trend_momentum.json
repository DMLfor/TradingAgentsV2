  "universe": {
    "board": "创业板",
    "min_price": 5,
    "max_price": 500,
    "exclude_st": true
  },
  "lookback": 120,
  "initial_capital": 1000000,
  "position": {
    "max_holding": 10,
    "per_position": 0.1,
    "weight_by": "equal"
  },
  "entry": {
    "conditions": [
      {"indicator": "composite_score", "op": ">=", "value": 7.0},
      {"indicator": "macd", "signal": "golden_cross"}
    ],
    "rank_by": "composite_score",
    "direction": "desc",
    "limit": 10
  },
  "exit": {
    "conditions": [
      {"indicator": "composite_score", "op": "<", "value": 5.0}
    ],
    "stop_loss": -0.08,
    "take_profit": 0.20,
    "max_hold_days": 20
  },
  "rebalance": {
    "frequency": "daily"
  },
  "costs": {
    "commission_buy": 0.00025,
    "commission_sell": 0.00025,
    "tax_sell": 0.001,
    "slippage": 0.0001
  }
