# 通信达数据同步配置 (Example - 复制为 tdx_config.yaml 后填写真实值)
tdx_dir: "C:\\new_tdx_mock"

# 数据库配置
db_type: "mysql"  # "mysql" 或 "sqlite"
db_path: "tdx_data.db"  # SQLite 文件路径（db_type=sqlite 时使用）

# MySQL 连接参数
mysql_host: "127.0.0.1"
mysql_port: 3306
mysql_user: "root"
mysql_password: "your_password"
mysql_database: "tdx_data"

batch_size: 20000
max_retries: 3
retry_delay: 1.0
log_dir: "logs"
log_retention_days: 30

# Metadata files
metadata_path: "config/stock_metadata.json"
names_path: "config/stock_names.json"
metadata_source: ""  # CSV source path (optional, for generation tracking)

# 通知配置（按需填写）
dingtalk_webhook: ""
smtp_host: ""
smtp_port: 465
smtp_user: ""
smtp_password: ""
notify_email: ""
